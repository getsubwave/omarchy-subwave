{
  "schemaVersion": 1,
  "id": "getsubwave.radio",
  "name": "SUB/WAVE Radio",
  "version": "0.1.0",
  "author": "SUB/WAVE",
  "license": "MIT",
  "description": "Tune into self-hosted AI DJ radio and discover public SUB/WAVE community stations.",
  "homepage": "https://github.com/getsubwave/omarchy-subwave",
  "repository": "https://github.com/getsubwave/omarchy-subwave",
  "keywords": ["radio", "subwave", "music", "mpris", "ai", "self-hosted"],
  "kinds": ["overlay", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "StationPicker.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "SUB/WAVE Radio",
    "description": "SUB/WAVE community radio player",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "left"
  }
}
